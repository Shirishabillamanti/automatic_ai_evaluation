rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check document ownership by UID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: Check if requester is an active teacher
    function isTeacher() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher_admin'
        ) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus == 'active';
    }

    // 1. Users collection
    match /users/{userId} {
      // Users can read their own profile; active teachers can read student profile records
      allow read: if isOwner(userId) || isTeacher();

      // Users can create their own profile during registration
      allow create: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        (request.resource.data.role in ['student', 'teacher', 'teacher_admin']) &&
        request.resource.data.accountStatus == 'active';

      // Profile updates cannot tamper with role or accountStatus
      allow update: if isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.accountStatus == resource.data.accountStatus;

      allow delete: if false;
    }

    // 2. Exams collection (Teacher creates and manages their exams)
    match /exams/{examId} {
      // Teachers can read and manage their own exams
      allow read: if isAuthenticated() && (
        resource.data.teacherId == request.auth.uid ||
        isTeacher()
      );

      // Only active teachers can create exams with their own UID
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;

      // Only the teacher who created the exam can update or delete it
      allow update, delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    // 3. Submissions / Answer sheets collection
    match /submissions/{submissionId} {
      // Teachers read submissions for their courses; students read their own submissions
      allow read: if isAuthenticated() && (
        resource.data.teacherId == request.auth.uid ||
        resource.data.studentId == request.auth.uid
      );

      // Teachers upload and evaluate submissions
      allow create, update: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    // 4. Activities collection (Audit and activity feed)
    match /activities/{activityId} {
      allow read: if isAuthenticated() && resource.data.teacherId == request.auth.uid;
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if false;
    }

    // 5. System notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.targetUid == request.auth.uid;
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // 6. Results collection (Published student evaluation reports)
    match /results/{resultId} {
      // Students can read ONLY their own PUBLISHED evaluation results.
      // Active teachers can read results for academic reporting.
      allow read: if isAuthenticated() && (
        (resource.data.studentUid == request.auth.uid && resource.data.status == 'published') ||
        isTeacher()
      );

      // Only authenticated active teachers can create, update or delete exam results.
      // Students are strictly forbidden from modifying or publishing results.
      allow create, update, delete: if isTeacher();
    }

    // 7. Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
